{
  "name": "encore-karaoke",
  "version": "1.11.0",
  "description": "Turn your PC into a karaoke machine, complete with scoring and recording features. For karaoke fans, by karaoke fans. Runs offline.",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "build:dev": "node build.js --dev",
    "start": "npm run build:dev && electron-forge start -- --dev",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Encore-Karaoke-Labs/Encore-Karaoke"
  },
  "keywords": [
    "htpc",
    "web-os",
    "movies",
    "tv"
  ],
  "author": "Encore Karaoke Labs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Encore-Karaoke-Labs/Encore-Karaoke/issues"
  },
  "homepage": "./",
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "loudness": "^0.4.2",
    "pdfkit": "^0.19.1",
    "systeminformation": "^5.33.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.4.0",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "4.2.0",
    "@xhayper/discord-rpc": "^1.3.4",
    "bonjour-service": "^1.4.4",
    "cdgraphics": "^7.0.0",
    "cors": "^2.8.6",
    "dompurify": "^3.4.13",
    "driver.js": "^1.8.0",
    "electron": "^43.4.1",
    "electron-packager-languages": "^0.6.0",
    "esbuild": "0.28.2",
    "express": "^5.2.1",
    "fuse.js": "^7.5.0",
    "ionicons": "^8.1.0",
    "kuroshiro": "^1.2.0",
    "localforage": "^1.10.0",
    "marked": "^18.0.10",
    "mime-types": "^3.0.2",
    "peerjs": "^1.5.5",
    "pitchy": "^4.1.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "spessasynth_core": "^4.3.20",
    "spessasynth_lib": "^4.3.14",
    "youtube-search-api": "^2.0.1"
  },
  "overrides": {
    "@electron/rebuild": "4.2.0",
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.5",
    "tmp": "0.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.4": true
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --cache --fix"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
